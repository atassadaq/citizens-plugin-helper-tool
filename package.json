{
  "name": "citizens-plugin-helper-tool",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "patch-package": "^8.0.1"
  }
}
